# Local release signing. Copy this file to android/app/keystore.properties
# (gitignored) and fill in the real values, or export the RELEASE_* variables.
#
# CI does NOT use this file: .github/workflows/release.yml restores the keystore
# from the RELEASE_KEYSTORE_BASE64 repository secret and reads the rest from
# RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=deadzone
keyPassword=CHANGE_ME
